[Unit]
Description=Create and verify a YOW THI ERP backup snapshot
After=postgresql.service
ConditionPathIsDirectory=/var/www/yowthi-erp/backend/public/uploads

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/yowthi-backup
ExecStartPost=/usr/local/sbin/yowthi-backup-verify /var/backups/yowthi-erp/latest
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
